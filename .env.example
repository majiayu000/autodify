# ============================================
# Autodify 环境配置
# ============================================
# 复制此文件为 .env: cp .env.example .env

# --------------------------------------------
# LLM 配置（必填，选择一种方式）
# --------------------------------------------

# 方式一：OpenRouter（推荐，支持多种模型）
LLM_PROVIDER=openai
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-your-key-here
LLM_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# 方式二：OpenAI 官方
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-key
# LLM_DEFAULT_MODEL=gpt-4o

# 方式三：Anthropic 官方
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_API_KEY=sk-ant-your-key
# LLM_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# --------------------------------------------
# 服务配置（可选，有默认值）
# --------------------------------------------
SERVER_PORT=3001
WEB_PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# --------------------------------------------
# API 认证（必填）— 保护 /api/generate 与 /api/refine
# --------------------------------------------
# 服务端校验 X-API-Key；前端通过 VITE_API_KEY 发送同一密钥
API_KEY=change-me-to-a-long-random-secret
VITE_API_KEY=change-me-to-a-long-random-secret

# --------------------------------------------
# 高级配置（通常不需要修改）
# --------------------------------------------
# CORS 允许的源
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 速率限制（canonical；Fastify timeWindow 可用毫秒数字或 "15 minutes"）
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_TIME_WINDOW=60000
RATE_LIMIT_GENERATE_MAX=20
RATE_LIMIT_GENERATE_TIME_WINDOW=15 minutes
RATE_LIMIT_REFINE_MAX=30
RATE_LIMIT_REFINE_TIME_WINDOW=15 minutes
# 兼容别名（仅当对应 GLOBAL_* 未设置时生效）:
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW=60000

# 缓存
CACHE_ENABLED=true
